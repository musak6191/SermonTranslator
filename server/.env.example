DATABASE_URL="file:/usr/home/bgx9gy/server/prisma/dev.db"
# Port the Express/Socket.IO server listens on (default: 3001)
PORT=3001
NODE_ENV=production
JWT_SECRET="change-me-to-a-long-random-secret"
CLIENT_BASE_URL="https://zermon.de"
CLIENT_BUILD_PATH="/usr/home/bgx9gy/server/public"
# ============================================================================
# Email (Resend)
# ============================================================================
RESEND_API_KEY="your-resend-api-key"

# ============================================================================
# Translation
# ============================================================================
# Optional override for the LibreTranslate endpoint
LIBRETRANSLATE_URL="https://libretranslate.com/translate"

# ============================================================================
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# ============================================================================
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
